<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/livestream/db" VERSION="20260323" COMMENT="LiveStream UN-CHK">
  <TABLES>
    <TABLE NAME="livestream" COMMENT="Instance du module LiveStream">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course"       TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="name"         TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="intro"        TYPE="text" NOTNULL="false"/>
        <FIELD NAME="introformat"  TYPE="int"  LENGTH="4"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="roomid"       TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="ID salle LiveStreamV2"/>
        <FIELD NAME="roomname"     TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="roomName LiveKit"/>
        <FIELD NAME="roomapihost"  TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="Hote de l'apiurl au moment de la creation de la salle : detecte un roomid appartenant a un autre backend (preprod vs prod)"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course"  TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
